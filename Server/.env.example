# Public URL of the deployed frontend.
# Example: https://your-auto-fixer.vercel.app
FRONTEND_URL=

# Optional comma-separated list if you have more than one allowed frontend origin.
# Example: https://your-auto-fixer.vercel.app,https://www.yourdomain.com
CORS_ORIGINS=

# Optional Supabase settings for the recommendation service.
SUPABASE_URL=
SUPABASE_KEY=
